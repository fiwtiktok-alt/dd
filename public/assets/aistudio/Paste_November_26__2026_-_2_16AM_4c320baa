            runtime.playhead = kf.frame; refreshAllUI();
          };
          lane.appendChild(kd);
        });
      });
      lanes.appendChild(lane);
    });
    updatePlayheadLine();
    if (project.ui.graphOpen) renderGraphEditor();
  }

  function updatePlayheadLine() {
