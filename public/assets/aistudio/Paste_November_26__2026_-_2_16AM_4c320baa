  const easeOutCubic = (t) => 1 - Math.pow(1 - clamp(t, 0, 1), 3);
  const easeInOutCubic = (t) => { const x = clamp(t, 0, 1); return x < 0.5 ? 4*x*x*x : 1 - Math.pow(-2*x + 2, 3) / 2; };

  function frameToTimecode(frame, fps) {
    const f = Math.max(0, Math.round(frame)), ff = f % fps, totalSec = Math.floor(f / fps);
    const ss = totalSec % 60, mm = Math.floor(totalSec / 60) % 60, hh = Math.floor(totalSec / 3600);
    const pad = (n) => String(n).padStart(2, '0');
    return `${pad(hh)}:${pad(mm)}:${pad(ss)}:${pad(ff)}`;
  }

  function frameToSrtTime(frame, fps) {
    const msTotal = Math.round((frame / fps) * 1000);
    const ms = msTotal % 1000, sec = Math.floor(msTotal / 1000) % 60;
    const min = Math.floor(msTotal / 60000) % 60, hr = Math.floor(msTotal / 3600000);
    return `${String(hr).padStart(2,'0')}:${String(min).padStart(2,'0')}:${String(sec).padStart(2,'0')},${String(ms).padStart(3,'0')}`;
