        <button class="tl-mini-btn ${layer.solo ? 'on' : ''}">S</button>
        <button class="tl-mini-btn ${layer.muted ? 'warn-on' : ''}">M</button>
        <span class="tl-row-name" title="${layer.name}">${layer.name}</span>
        <span class="tl-type-badge">${layer.type.slice(0, 4)}</span>`;
      const [btnVis, btnLock, btnSolo, btnMute] = rHead.querySelectorAll('button');
      btnVis.onclick = (e) => { e.stopPropagation(); pushUndo(); layer.hidden = !layer.hidden; refreshAllUI(); };
      btnLock.onclick = (e) => { e.stopPropagation(); pushUndo(); layer.locked = !layer.locked; refreshAllUI(); };
      btnSolo.onclick = (e) => { e.stopPropagation(); pushUndo(); layer.solo = !layer.solo; refreshAllUI(); };
      btnMute.onclick = (e) => { e.stopPropagation(); pushUndo(); layer.muted = !layer.muted; refreshAllUI(); };
      rHead.ondblclick = () => { const nn = prompt('Rename layer:', layer.name); if (nn) { pushUndo(); layer.name = nn; renderTimeline(); } };
      rHead.onclick = () => { runtime.selectedLayerId = layer.id; refreshAllUI(); };
      leftRows.appendChild(rHead);

      const lane = document.createElement('div'); lane.className = 'tl-lane' + (isSel ? ' selected' : '');
      const clip = document.createElement('div'); clip.className = 'tl-clip' + (isSel ? ' selected' : '') + (layer.locked ? ' locked' : '');
      const leftPx = (layer.startFrame / comp.fps) * pps;
      const widthPx = Math.max(10, ((layer.endFrame - layer.startFrame + 1) / comp.fps) * pps);
      clip.style.left = `${leftPx}px`; clip.style.width = `${widthPx}px`;
      clip.style.background = colorMap[layer.type] || '#343b4a';
      clip.innerHTML = `<div class="tl-clip-handle left"></div><span style="position:relative;z-index:2;pointer-events:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${layer.name}</span><div class="tl-clip-handle right"></div>`;

      if (layer.kind === 'audio' && layer.assetId) {
        const wCanvas = document.createElement('canvas'); wCanvas.className = 'tl-clip-wave';
        wCanvas.width = Math.min(800, Math.max(20, Math.round(widthPx))); wCanvas.height = 20;
        const m = runtime.mediaCache.get(layer.assetId);
        const peaks = m?.peaks || Array.from({ length: 40 }, (_, i) => 0.25 + 0.55 * Math.abs(Math.sin(i * 0.45)));
        const wctx = wCanvas.getContext('2d'); wctx.fillStyle = '#a7f3d0';
        const bw = wCanvas.width / peaks.length;
        peaks.forEach((pk, i) => { const bh = Math.max(2, pk * 18); wctx.fillRect(i * bw, 10 - bh / 2, Math.max(1, bw - 1), bh); });
        clip.appendChild(wCanvas);
      }

      clip.onmousedown = (ev) => {
        ev.stopPropagation(); runtime.selectedLayerId = layer.id; renderInspector();
        if (layer.locked) return toast('Layer is locked');
        const mode = ev.target.classList.contains('left') ? 'trimL' : ev.target.classList.contains('right') ? 'trimR' : 'move';
        const startX = ev.clientX, origS = layer.startFrame, origE = layer.endFrame;
        let moved = false;
        const onMove = (mv) => {
          const df = Math.round(((mv.clientX - startX) / pps) * comp.fps);
          if (df !== 0 && !moved) { pushUndo(); moved = true; }
          if (mode === 'move') {
            const len = origE - origS; let ns = clamp(origS + df, 0, comp.durationFrames - 1 - len);
            if (project.ui.snapping && Math.abs(ns - runtime.playhead) <= 4) ns = runtime.playhead;
            layer.startFrame = ns; layer.endFrame = ns + len;
          } else if (mode === 'trimL') layer.startFrame = clamp(origS + df, 0, origE - 2);
          else layer.endFrame = clamp(origE + df, origS + 2, comp.durationFrames - 1);
          clip.style.left = `${(layer.startFrame / comp.fps) * pps}px`;
          clip.style.width = `${Math.max(10, ((layer.endFrame - layer.startFrame + 1) / comp.fps) * pps)}px`;
        };
        const onUp = () => { window.removeEventListener('mousemove', onMove); window.removeEventListener('mouseup', onUp); refreshAllUI(); };
        window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onUp);
