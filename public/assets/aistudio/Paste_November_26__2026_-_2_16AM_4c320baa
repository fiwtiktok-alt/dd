  function cubicBezierY(t, cp1, cp2) {
    const cx = (u) => 3*(1-u)*(1-u)*u*cp1[0] + 3*(1-u)*u*u*cp2[0] + u*u*u;
    const cy = (u) => 3*(1-u)*(1-u)*u*cp1[1] + 3*(1-u)*u*u*cp2[1] + u*u*u;
    let lo = 0, hi = 1, u = t;
    for (let i = 0; i < 14; i++) { u = (lo + hi) * 0.5; const x = cx(u); if (Math.abs(x - t) < 1e-4) break; if (x < t) lo = u; else hi = u; }
    return cy(u);
  }

  function applyEasing(t, kf) {
    const e = kf.easing || 'easeInOut';
    if (e === 'hold') return 0;
    if (e === 'linear') return t;
    if (e === 'easeIn') return cubicBezierY(t, [0.42, 0], [1, 1]);
    if (e === 'easeOut') return cubicBezierY(t, [0, 0], [0.58, 1]);
    if (e === 'easeInOut') return cubicBezierY(t, [0.42, 0], [0.58, 1]);
    if (e === 'bezier') return cubicBezierY(t, kf.cp1 || [0.42, 0], kf.cp2 || [0.58, 1]);
