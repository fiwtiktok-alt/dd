    document.getElementById('tl-tracks-inner').style.width = `${totalW}px`;

    const colorMap = { '3d': '#1a6b73', 'text': '#51377d', 'subtitle': '#2b6a65', 'shape': '#31394a', 'image': '#6d4c2f', 'video': '#6d4c2f', 'voiceover': '#2f6f44', 'music': '#26543a', 'sfx': '#495a2b', 'adjustment': '#554422' };

