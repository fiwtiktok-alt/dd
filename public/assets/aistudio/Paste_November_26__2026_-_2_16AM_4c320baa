    document.getElementById('tl-layer-count').textContent = `${project.layers.length} layers`;

    const ruler = document.getElementById('tl-ruler'); ruler.width = totalW; ruler.height = 24;
    const rctx = ruler.getContext('2d'); rctx.fillStyle = '#121419'; rctx.fillRect(0, 0, totalW, 24);
    rctx.strokeStyle = '#2d3340'; rctx.fillStyle = '#8b92a0'; rctx.font = '10px monospace';
    const maxSec = Math.ceil(comp.durationFrames / comp.fps);
    for (let s = 0; s <= maxSec; s++) {
      const x = s * pps; rctx.beginPath(); rctx.moveTo(x, 12); rctx.lineTo(x, 24); rctx.stroke();
