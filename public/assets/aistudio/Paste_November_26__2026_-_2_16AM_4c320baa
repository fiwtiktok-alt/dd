    document.getElementById('tl-play').textContent = runtime.isPlaying ? '⏸' : '▶';
    document.getElementById('btn-preview-play').textContent = runtime.isPlaying ? '⏸ Pause' : '▶ Play';
    if (runtime.isPlaying) {
      if (runtime.playhead >= project.composition.durationFrames - 1) runtime.playhead = 0;
      runtime.lastTick = performance.now();
      audioEngine.startPlaybackFromFrame(runtime.playhead);
      requestAnimationFrame(playStep);
