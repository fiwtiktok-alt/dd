  }

  function playStep(now) {
    if (!runtime.isPlaying) return;
    const fps = project.composition.fps, elapsedFrames = Math.floor(((now - runtime.lastTick) / 1000) * fps);
    if (elapsedFrames >= 1) {
      runtime.playhead += elapsedFrames; runtime.lastTick = now;
      if (runtime.playhead >= project.composition.durationFrames) { runtime.playhead = 0; audioEngine.startPlaybackFromFrame(0); }
      renderPreview(); updatePlayheadLine();
    }
    requestAnimationFrame(playStep);
  }

  (() => {
    const canvas = document.getElementById('preview-canvas');
    canvas.onmousedown = (e) => {
      const rect = canvas.getBoundingClientRect();
      const cx = ((e.clientX - rect.left) / rect.width) * project.composition.width;
      const cy = ((e.clientY - rect.top) / rect.height) * project.composition.height;
      const hit = project.layers.find(l => {
        if (l.kind === 'audio' || l.hidden || l.locked || runtime.playhead < l.startFrame || runtime.playhead > l.endFrame) return false;
        const lx = evalProp(l, 'x', runtime.playhead), ly = evalProp(l, 'y', runtime.playhead);
        const w = (l.props.width || 400) * (evalProp(l, 'scaleX', runtime.playhead) / 100), h = (l.props.height || 300) * (evalProp(l, 'scaleY', runtime.playhead) / 100);
        return Math.abs(cx - lx) <= w / 2 && Math.abs(cy - ly) <= h / 2;
      });
      if (!hit) return;
      runtime.selectedLayerId = hit.id; renderInspector(); renderTimeline(); renderPreview();
      const startX = evalProp(hit, 'x', runtime.playhead), startY = evalProp(hit, 'y', runtime.playhead);
      let pushed = false;
      const onMove = (mv) => {
        const dx = ((mv.clientX - e.clientX) / rect.width) * project.composition.width, dy = ((mv.clientY - e.clientY) / rect.height) * project.composition.height;
