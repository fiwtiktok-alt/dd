  function renderGraphEditor() {
    const drawer = document.getElementById('graph-drawer');
    drawer.classList.toggle('open', !!project.ui.graphOpen);
    if (!project.ui.graphOpen) return;
    const canvas = document.getElementById('graph-canvas');
    canvas.width = canvas.clientWidth || 700; canvas.height = 96;
    const ctx = canvas.getContext('2d'); ctx.fillStyle = '#0e1014'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    const layer = project.layers.find(l => l.id === runtime.selectedLayerId);
    const prop = document.getElementById('graph-prop-select').value;
    document.getElementById('graph-label').textContent = layer ? `Graph: ${layer.name} → ${prop}` : 'Graph Editor';
    if (!layer) return;
    const kfs = layer.keyframes?.[prop] || [];
    if (!kfs.length) { ctx.fillStyle = '#666d7c'; ctx.font = '11px sans-serif'; ctx.fillText('No keyframes on this property.', 12, 50); return; }

    const minF = 0, maxF = Math.max(1, project.composition.durationFrames), vals = kfs.map(k => k.value);
    const minV = Math.min(...vals) - 10, maxV = Math.max(...vals) + 10;
    const toX = f => 16 + ((f - minF) / (maxF - minF)) * (canvas.width - 32);
    const toY = v => canvas.height - 14 - ((v - minV) / Math.max(1e-4, maxV - minV)) * (canvas.height - 28);

    ctx.strokeStyle = '#2d7ff9'; ctx.lineWidth = 2; ctx.beginPath();
    for (let px = 16; px <= canvas.width - 16; px += 6) {
      const f = minF + ((px - 16) / (canvas.width - 32)) * (maxF - minF), y = toY(evalProp(layer, prop, f));
      if (px === 16) ctx.moveTo(px, y); else ctx.lineTo(px, y);
    }
    ctx.stroke();
    kfs.forEach(k => { ctx.fillStyle = runtime.selectedKeyframe?.kfId === k.id ? '#fff' : '#f5b942'; ctx.beginPath(); ctx.arc(toX(k.frame), toY(k.value), 5, 0, Math.PI * 2); ctx.fill(); });
  }

