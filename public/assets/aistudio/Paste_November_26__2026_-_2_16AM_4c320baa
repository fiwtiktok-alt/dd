    const base = layer.props[prop], kfs = layer.keyframes && layer.keyframes[prop];
    if (!kfs || kfs.length === 0) return base;
    if (frame <= kfs[0].frame) return kfs[0].value;
    if (frame >= kfs[kfs.length - 1].frame) return kfs[kfs.length - 1].value;
    for (let i = 0; i < kfs.length - 1; i++) {
      const a = kfs[i], b = kfs[i + 1];
      if (frame >= a.frame && frame <= b.frame) {
        if (a.easing === 'hold' || b.frame === a.frame) return a.value;
        return lerp(a.value, b.value, applyEasing(clamp((frame - a.frame) / (b.frame - a.frame), 0, 1), a));
      }
    }
    return base;
  }

