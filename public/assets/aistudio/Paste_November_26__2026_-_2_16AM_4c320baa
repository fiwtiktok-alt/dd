        issues.push({ id: uid('qc'), level: 'warn', msg: 'Voice-over track has no imported MP3/WAV yet (subtitles use estimated WPM).', fixLabel: 'Import Audio', fix: () => document.getElementById('file-import-input').click() });
      }
      if (!issues.length) issues.push({ id: uid('qc'), level: 'ok', msg: 'All QC checks passed: 3D Glass UI choreography, safe areas, transitions, and keyframes are consistent.' });
      project.qcIssues = issues;
      return issues;
    },

    applyNaturalEdit(promptText) {
      const q = promptText.toLowerCase().trim();
      if (!q) return 'Enter an editing instruction.';
      pushUndo();
      if (q.includes('hide all subtitles') || q.includes('sembunyikan subtitle')) { project.ui.showSubtitles = false; refreshAllUI(); return 'Subtitles hidden cleanly.'; }
      if (q.includes('mute text') || q.includes('bisukan teks')) { project.ui.muteTextOnFrame = true; refreshAllUI(); return 'Mute Text on Frame enabled.'; }
      const sel = project.layers.find(l => l.id === runtime.selectedLayerId && !l.locked);
      if (sel && sel.type === '3d' && (q.includes('smaller') || q.includes('perkecil'))) { sel.props.scaleX *= 0.85; sel.props.scaleY *= 0.85; renderPreview(); return 'Scaled 3D UI down by 15%.'; }
      if (sel && (q.includes('duration') || q.includes('durasi'))) { sel.endFrame += 30; refreshAllUI(); return 'Extended selected layer by +1.0s.'; }
      return 'Try: "Hide all subtitles", "Mute text", "Make 3D smaller", or "Increase duration".';
    }
  };

  /* ============================================================
     RELIABLE REAL EXPORT & SAVE VIDEO ENGINE
     ============================================================ */
  function buildSrtString() {
    const fps = project.composition.fps;
    return project.layers.filter(l => l.type === 'subtitle' && !l.hidden).sort((a, b) => a.startFrame - b.startFrame)
      .map((s, i) => `${i + 1}\n${frameToSrtTime(s.startFrame, fps)} --> ${frameToSrtTime(s.endFrame, fps)}\n${s.text?.content || ''}\n`).join('\n');
  }

  function audioBufferToWavBlob(buffer) {
    const numOfChan = buffer.numberOfChannels, length = buffer.length * numOfChan * 2 + 44;
    const out = new ArrayBuffer(length), view = new DataView(out);
    let pos = 0;
    const set16 = d => { view.setUint16(pos, d, true); pos += 2; };
    const set32 = d => { view.setUint32(pos, d, true); pos += 4; };
    set32(0x46464952); set32(length - 8); set32(0x45564157);
    set32(0x20746d66); set32(16); set16(1); set16(numOfChan);
    set32(buffer.sampleRate); set32(buffer.sampleRate * 2 * numOfChan);
    set16(numOfChan * 2); set16(16); set32(0x61746164); set32(length - pos - 4);
    const ch = []; for (let i = 0; i < numOfChan; i++) ch.push(buffer.getChannelData(i));
    let offset = 0;
    while (pos < length) {
      for (let i = 0; i < numOfChan; i++) {
        const s = clamp(ch[i][offset] || 0, -1, 1);
        view.setInt16(pos, s < 0 ? s * 0x8000 : s * 0x7FFF, true); pos += 2;
      }
      offset++;
    }
    return new Blob([out], { type: 'audio/wav' });
  }

  function deliverFileResult(blob, filename, isVideo = false) {
    if (runtime.lastExportBlobUrl) { try { URL.revokeObjectURL(runtime.lastExportBlobUrl); } catch (_) {} }
    const url = URL.createObjectURL(blob);
    runtime.lastExportBlobUrl = url;

    const rBox = document.getElementById('ex-result-box');
    const vidEl = document.getElementById('ex-video-preview');
    const dlLink = document.getElementById('ex-download-link');
    rBox.style.display = 'block';
    dlLink.href = url;
    dlLink.download = filename;
    dlLink.textContent = `💾 Save ${filename} (${(blob.size / (1024 * 1024) >= 0.1 ? (blob.size / (1024 * 1024)).toFixed(2) + ' MB' : Math.round(blob.size / 1024) + ' KB')})`;

    if (isVideo) {
      vidEl.style.display = 'block';
      vidEl.src = url;
    } else {
      vidEl.style.display = 'none';
      vidEl.removeAttribute('src');
    }

    // Also attempt automatic download click
    try {
      const a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
    } catch (_) {}
  }

  window.cancelExportIfActive = () => {
    if (runtime.exporting) { runtime.exportCancel = true; toast('Cancelling export...'); }
    else closeModal('modal-export');
  };

  async function startRealExport() {
    if (runtime.exporting) return;
    const fmt = document.getElementById('ex-format').value;
    const scale = parseFloat(document.getElementById('ex-res').value);
    const fps = parseInt(document.getElementById('ex-fps').value, 10);
    const mbps = parseInt(document.getElementById('ex-bitrate').value, 10) || 6;
    const subMode = document.getElementById('ex-subs').value;
    const rangeMode = document.getElementById('ex-range').value;
    const transparentBg = document.getElementById('ex-alpha').checked;

    const comp = project.composition, w = Math.round(comp.width * scale), h = Math.round(comp.height * scale);
    const maxUsedFrame = project.layers.length ? Math.max(...project.layers.map(l => l.endFrame)) : comp.durationFrames - 1;
    const totalFrames = rangeMode === 'highlight'
      ? Math.min(comp.durationFrames, fps * 12)
      : rangeMode === 'content' ? maxUsedFrame + 1 : comp.durationFrames;

    const pBar = document.getElementById('ex-progress-bar'), pTxt = document.getElementById('ex-progress-text');
    const startBtn = document.getElementById('ex-start-btn');
    const safeName = (project.name || 'voya_render').replace(/[^a-z0-9_-]/gi, '_');

    document.getElementById('ex-result-box').style.display = 'none';
    setProjectStatus('Exporting'); runtime.exporting = true; runtime.exportCancel = false;
    startBtn.disabled = true;

    try {
      if (fmt === 'srt') {
        const srt = buildSrtString();
        if (!srt.trim()) throw new Error('No subtitle layers exist.');
        const blob = new Blob([srt], { type: 'text/plain;charset=utf-8' });
        deliverFileResult(blob, `${safeName}.srt`, false);
        pBar.style.width = '100%'; pTxt.textContent = `Exported SRT (${blob.size} bytes).`;
        setProjectStatus('Export completed'); return;
      }
      if (fmt === 'png') {
        const off = document.createElement('canvas'); off.width = w; off.height = h;
        const octx = off.getContext('2d'); octx.scale(scale, scale);
        renderCompositionFrame(octx, comp.width, comp.height, runtime.playhead, { isExport: true, subMode, transparentBg });
        const blob = await new Promise(res => off.toBlob(res, 'image/png'));
        if (!blob || blob.size === 0) throw new Error('PNG encoding failed.');
        deliverFileResult(blob, `${safeName}_f${runtime.playhead}.png`, false);
        pBar.style.width = '100%'; pTxt.textContent = `PNG exported (${Math.round(blob.size / 1024)} KB).`;
        setProjectStatus('Export completed'); return;
      }
      if (fmt === 'wav') {
        const ctx = audioEngine.ensureCtx(), durSec = totalFrames / fps;
        const offCtx = new OfflineAudioContext(1, Math.max(1, Math.floor(ctx.sampleRate * durSec)), ctx.sampleRate);
        for (const l of project.layers) {
          if (l.kind !== 'audio' || l.muted) continue;
          let m = runtime.mediaCache.get(l.assetId);
          const ast = project.assets.find(a => a.id === l.assetId);
          if (!m && ast?.source === 'Synthesized WebAudio') {
            const buf = audioEngine.synthesizeBuiltInBuffer(ast.subkind, ast.duration || 1);
            if (buf) m = { audioBuffer: buf };
          }
          if (!m?.audioBuffer) continue;
          const s = offCtx.createBufferSource(); s.buffer = m.audioBuffer;
          if (ast?.loop || l.type === 'music') s.loop = true;
          const g = offCtx.createGain(); g.gain.value = (l.audio?.volume ?? 100) / 100;
          s.connect(g); g.connect(offCtx.destination);
          s.start(l.startFrame / fps, l.audio?.trimOffsetSec || 0, (l.endFrame - l.startFrame) / fps);
        }
        const wav = audioBufferToWavBlob(await offCtx.startRendering());
        deliverFileResult(wav, `${safeName}.wav`, false);
        pBar.style.width = '100%'; pTxt.textContent = `WAV exported (${Math.round(wav.size / 1024)} KB).`;
        setProjectStatus('Export completed'); return;
      }
      if (fmt === 'pngseq') {
        const off = document.createElement('canvas'); off.width = w; off.height = h;
        const octx = off.getContext('2d'), step = Math.max(1, Math.floor(totalFrames / 12));
        let lastBlob = null, count = 0;
        for (let f = 0; f < totalFrames; f += step) {
          if (runtime.exportCancel) throw new Error('Export cancelled.');
          octx.setTransform(scale, 0, 0, scale, 0, 0);
          renderCompositionFrame(octx, comp.width, comp.height, f, { isExport: true, subMode, transparentBg });
          lastBlob = await new Promise(res => off.toBlob(res, 'image/png'));
          deliverFileResult(lastBlob, `${safeName}_seq_${String(f).padStart(4,'0')}.png`, false);
          count++; pBar.style.width = `${Math.round((f / totalFrames) * 100)}%`;
          pTxt.textContent = `Exporting PNG sequence frame ${f}/${totalFrames}...`;
          await new Promise(r => setTimeout(r, 90));
        }
        pBar.style.width = '100%'; pTxt.textContent = `Exported ${count} PNG frames.`;
        setProjectStatus('Export completed'); return;
      }

      if (typeof MediaRecorder === 'undefined') throw new Error('MediaRecorder API not available in this browser.');

      // Prefer fast VP8 WebM (or H.264 MP4 if natively supported)
      const mimeCandidates = fmt === 'mp4'
        ? ['video/mp4;codecs=avc1.42E01E,mp4a.40.2', 'video/mp4']
        : ['video/webm;codecs=vp8,opus', 'video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8', 'video/webm'];
      const chosenMime = mimeCandidates.find(m => MediaRecorder.isTypeSupported(m));
      if (!chosenMime) throw new Error(`Browser MediaRecorder does not support ${fmt.toUpperCase()}. Try WebM.`);

      const off = document.createElement('canvas'); off.width = w; off.height = h;
      const octx = off.getContext('2d');
      octx.setTransform(scale, 0, 0, scale, 0, 0);
      renderCompositionFrame(octx, comp.width, comp.height, 0, { isExport: true, subMode, transparentBg });

      const vStream = off.captureStream(fps);
      const actx = audioEngine.ensureCtx();
      let dest = null, keepOsc = null;
      if (actx && chosenMime.includes('opus')) {
        dest = actx.createMediaStreamDestination();
        // Keepalive silent signal (-90 dB) so MediaRecorder never stalls waiting on audio frames
        keepOsc = actx.createOscillator();
        const keepGain = actx.createGain();
        keepGain.gain.value = 0.00003;
        keepOsc.connect(keepGain); keepGain.connect(dest); keepOsc.start();
        dest.stream.getAudioTracks().forEach(t => vStream.addTrack(t));
      }

      const chunks = [];
      let rec;
      try {
        rec = new MediaRecorder(vStream, { mimeType: chosenMime, videoBitsPerSecond: mbps * 1_000_000 });
      } catch (_) {
        // Fallback to video-only stream if audio track mix fails in strict sandbox
        const videoOnly = off.captureStream(fps);
        rec = new MediaRecorder(videoOnly, { mimeType: 'video/webm' });
      }
      rec.ondataavailable = (e) => { if (e.data && e.data.size > 0) chunks.push(e.data); };
      const donePromise = new Promise((resolve, reject) => {
        rec.onstop = resolve;
        rec.onerror = ev => reject(ev.error || new Error('MediaRecorder error'));
      });

      rec.start(200);
      if (dest) audioEngine.startPlaybackFromFrame(0, dest);

      const startWall = performance.now(), frameMs = 1000 / fps;
      for (let f = 0; f < totalFrames; f++) {
        if (runtime.exportCancel) {
          try { rec.stop(); } catch (_) {}
          if (keepOsc) try { keepOsc.stop(); } catch (_) {}
          audioEngine.stopPlayback();
          throw new Error('Export cancelled.');
        }
        octx.setTransform(scale, 0, 0, scale, 0, 0);
        renderCompositionFrame(octx, comp.width, comp.height, f, { isExport: true, subMode, transparentBg });
        const pct = Math.round(((f + 1) / totalFrames) * 100);
        const elapsed = (performance.now() - startWall) / 1000;
        const eta = f > 4 ? Math.max(0, Math.round((elapsed / (f + 1)) * (totalFrames - f - 1))) : '...';
        pBar.style.width = `${pct}%`;
        pTxt.textContent = `Rendering ${chosenMime.split(';')[0]} — Frame ${f + 1}/${totalFrames} (${pct}%) • ETA ${eta}s`;
        await new Promise(r => setTimeout(r, Math.max(4, startWall + (f + 1) * frameMs - performance.now())));
      }

      audioEngine.stopPlayback();
      if (keepOsc) try { keepOsc.stop(); } catch (_) {}
      rec.stop();
      await donePromise;

      const outBlob = new Blob(chunks, { type: rec.mimeType || chosenMime });
      if (outBlob.size === 0) throw new Error('Generated video file was 0 bytes. Try Chrome/Edge locally or lower resolution.');
      const ext = (rec.mimeType || chosenMime).includes('mp4') ? 'mp4' : 'webm';
      deliverFileResult(outBlob, `${safeName}.${ext}`, true);

      if (subMode === 'burnAndSrt') {
        const srt = buildSrtString();
        if (srt.trim()) {
          const sb = new Blob([srt], { type: 'text/plain' });
          const a = document.createElement('a'); a.href = URL.createObjectURL(sb); a.download = `${safeName}.srt`; a.click();
        }
      }

      pBar.style.width = '100%';
      pTxt.textContent = `Export completed! Real ${ext.toUpperCase()} (${(outBlob.size / (1024 * 1024)).toFixed(2)} MB).`;
      setProjectStatus('Export completed');
      toast('Video render ready to save!');
    } catch (err) {
      pTxt.textContent = `Export failed: ${err.message}`;
      setProjectStatus('Export failed');
      toast(err.message);
    } finally {
      runtime.exporting = false;
      startBtn.disabled = false;
    }
  }

  function renderPreview() {
    const canvas = document.getElementById('preview-canvas'), stage = document.getElementById('preview-stage'), comp = project.composition;
    if (canvas.width !== comp.width || canvas.height !== comp.height) { canvas.width = comp.width; canvas.height = comp.height; }
    const sw = Math.max(120, stage.clientWidth - 18), sh = Math.max(120, stage.clientHeight - 18);
    let scale = project.ui.zoomLevel;
    if (project.ui.zoomMode === 'fit') scale = Math.min(sw / comp.width, sh / comp.height);
    else if (project.ui.zoomMode === 'fitW') scale = sw / comp.width;
    else if (project.ui.zoomMode === 'fitH') scale = sh / comp.height;
    scale = clamp(scale, 0.08, 2.0); project.ui.zoomLevel = scale;
    canvas.style.width = `${Math.round(comp.width * scale)}px`;
    canvas.style.height = `${Math.round(comp.height * scale)}px`;
    renderCompositionFrame(canvas.getContext('2d'), comp.width, comp.height, runtime.playhead, { isExport: false });
    document.getElementById('tl-timecode').textContent = frameToTimecode(runtime.playhead, comp.fps);
    document.getElementById('comp-info-label').textContent = `${comp.name} • ${comp.width}×${comp.height} • ${comp.fps} fps • ${(comp.durationFrames / comp.fps).toFixed(1)}s`;
